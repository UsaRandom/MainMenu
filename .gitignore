# Ignore editor specific config folders/files
/.vscode

# Ignore compilation result directories
/build
/output
/docs/api
/_site

# Ignore generated files in the libdragon FS
/filesystem/*.font64
/filesystem/*.wav64
/filesystem/*.sprite
/filesystem/credits.txt
/filesystem/icons.meta

# icons.pack is the 3,894 icons in assets/icons concatenated by tools/mkpack.py into one blob the
# ROM can seek within, 6,561,304 bytes of it. Ignored because it is generated, like every other
# entry in this block -- not because of what is in it. The artwork itself IS committed, in
# assets/icons, with its licence and its 36 authors beside it; see assets/icons/README.md.
/filesystem/icons.pack

# Upstream ignored /tools/* wholesale, for the third-party sc64 deployer binaries it drops in
# tools/sc64/. Everything else under tools/ is now OURS -- the fixture generator, the input
# scripts, the regression harness, the corpus fetchers -- and losing it on clone would take the
# whole measurement culture with it. Ignore the vendored binaries specifically instead.
/tools/sc64/*
!/tools/sc64/.gitkeep

# Ignore any N64 ROM
**/*.n64
**/*.v64
**/*.z64

# Ignore exe files
*.exe

# Ignore macOS filesystem cruft
.DS_Store

# The cheat corpus and the databases built from it are release artifacts, not source.
# tools/mkcheatdb.py refetches; tools/data/n64_keys.tsv IS committed -- it is a table of pure
# facts and regenerating it needs both corpora present.
/build/cht/
/build/cheats.db

# Real title-card art fetched from n64-tools/n64-flashcart-menu-metadata for testing.
# 1.77 GB upstream, Unlicense, and not ours to vendor. tools/getart.py refetches it.
/build/artcache/
/filesystem/music/
